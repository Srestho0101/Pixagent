# Mistral
MISTRAL_API_KEY=replace_me
MISTRAL_MODEL=mistral-small-latest

# Supabase: use a server-only secret/service_role key, never a publishable/anon key.
POSTGRESQL_PASS=pass
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_secret_replace_me
SUPABASE_SERVICE_ROLE_KEY=YourServiceRoleKey

# Server configuration
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000